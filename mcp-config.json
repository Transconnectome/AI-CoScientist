{
  "mcpServers": {
    "academic-search": {
      "command": "python3",
      "args": [
        "-m",
        "src.mcp.academic_search"
      ],
      "cwd": "/home/juke/git/AI-CoScientist",
      "env": {}
    },
    "ai-coscientist": {
      "command": "python3",
      "args": [
        "-m",
        "src.mcp.server"
      ],
      "cwd": "/home/juke/git/AI-CoScientist",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "/home/juke/git/AI-CoScientist",
        "--context",
        "desktop-app",
        "--mode",
        "interactive,editing"
      ],
      "disabled": false
    }
  }
}