# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI-CoScientist - Connectome Server Hybrid Deployment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# This configuration deploys AI-CoScientist on SNU Connectome server with:
# - 8x NVIDIA RTX 3090 GPUs (24GB each)
# - Hybrid AI: GPT-4 + Claude + Nemotron
# - Production-grade security and monitoring
#
# GPU Assignments:
# - GPU 1: Nemotron LLM (9B model, ~18GB VRAM)
# - GPU 5: NeMo Embedder (1B model, ~4GB VRAM)
# - GPU 6: NeMo Reranker (1B model, ~4GB VRAM)
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENVIRONMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Deployment metadata (auto-generated by deploy script)
DEPLOYED_AT=
GIT_COMMIT=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CONNECTOME GPU CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GPU assignments (8x RTX 3090 available)
# Based on GPU utilization scan: GPUs 1, 5, 6 have ~24GB free
NEMOTRON_GPU_ID=1
NEMO_EMBEDDER_GPU_ID=5
NEMO_RERANKER_GPU_ID=6

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NVIDIA NIM CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# NGC API Key (Required for NIM containers)
# Get from: https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=YOUR_NGC_API_KEY_HERE

# NIM Optimization Profile
# Options: 'throughput' (max tokens/sec) or 'latency' (min TTFT/ITL)
# Connectome: Use 'throughput' for maximum efficiency
NIM_OPTIMIZATION_PROFILE=throughput

# Nemotron LLM Configuration (Docker internal URL)
NEMOTRON_BASE_URL=http://nemotron-llm:8000/v1
NEMOTRON_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NEMOTRON_TEMPERATURE=0.7
NEMOTRON_MAX_TOKENS=2048

# NeMo Retriever Embedding Configuration (Docker internal URL)
NEMO_EMBEDDER_URL=http://nemo-embedder:8000/v1
NEMO_EMBEDDER_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
EMBEDDER_TRUNCATE=END
EMBEDDING_DIMENSION=1024

# NeMo Retriever Reranker Configuration (Docker internal URL)
NEMO_RERANKER_URL=http://nemo-reranker:8000/v1
NEMO_RERANKER_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANKER_TOP_K=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HYBRID MODE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable hybrid mode (GPT-4/Claude + Nemotron)
HYBRID_MODE=true

# Task routing configuration
USE_GPT4_FOR_EVALUATION=true
USE_CLAUDE_FOR_EVALUATION=true
USE_NEMOTRON_FOR_SUMMARIZATION=true
USE_NEMOTRON_FOR_EXTRACTION=true
USE_NEMOTRON_FOR_CLASSIFICATION=true

# Ensemble weights (must sum to 1.0)
ENSEMBLE_WEIGHT_GPT4=0.40
ENSEMBLE_WEIGHT_CLAUDE=0.30
ENSEMBLE_WEIGHT_NEMOTRON=0.30

# Quality threshold for Nemotron-only tasks
# If confidence < threshold, escalate to GPT-4/Claude
NEMOTRON_CONFIDENCE_THRESHOLD=0.75

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EXTERNAL LLM APIs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# OpenAI API (for GPT-4)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096

# Anthropic API (for Claude) - Optional but recommended
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-opus-4
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_MAX_TOKENS=4096

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PostgreSQL (auto-generated secure password by deploy script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=ai_coscientist
POSTGRES_PORT=5432

# ChromaDB (Vector Database for RAG)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMA_TELEMETRY=FALSE

# ChromaDB Collections
CHROMADB_COLLECTION_IMPROVEMENTS=improvement_patterns
CHROMADB_COLLECTION_PHRASES=successful_phrases
CHROMADB_COLLECTION_TEMPLATES=section_templates

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REDIS CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# APPLICATION CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

APP_NAME=AI-CoScientist
APP_VERSION=1.0.0
API_PORT=8080

# Celery Configuration (using Redis as broker)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LITERATURE SOURCE APIs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ArXiv API (optional but recommended for better rate limits)
ARXIV_API_KEY=

# PubMed API (optional - improves download speeds)
PUBMED_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MONITORING CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Prometheus
PROMETHEUS_PORT=9090

# Grafana (auto-generated password by deploy script)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-password
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PLUGINS=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PERFORMANCE TUNING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Uvicorn workers (API server)
# Connectome: 4 workers recommended for 8-core CPU
UVICORN_WORKERS=4

# Celery concurrency (async task workers)
# Connectome: 4 concurrent tasks recommended
CELERY_CONCURRENCY=4

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Secret key for session management (auto-generated by deploy script)
SECRET_KEY=YOUR_SECURE_SECRET_KEY_HERE

# CORS Origins (comma-separated)
# Connectome: Allow only specific domains in production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PATHS & STORAGE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Papers collection directory
PAPERS_COLLECTION_DIR=./papers_collection

# Logs directory
LOGS_DIR=./logs

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPLOYMENT NOTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Required API Keys:
#    - NGC_API_KEY: Get from https://org.ngc.nvidia.com/setup/api-key
#    - OPENAI_API_KEY: Get from https://platform.openai.com/api-keys
#    - ANTHROPIC_API_KEY: (Optional) Get from https://console.anthropic.com/
#
# 2. Auto-Generated Secrets (by deploy_to_connectome_hybrid.sh):
