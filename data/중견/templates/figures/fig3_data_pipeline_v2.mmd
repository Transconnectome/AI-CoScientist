        CSU["조선대 코호트<br/>10,000명 종단<br/>50-90세 노화"]
    end

    subgraph PREPROCESS["전처리"]
        direction TB
        MRIP["MRI 전처리<br/>FreeSurfer<br/>fMRIPrep"]
