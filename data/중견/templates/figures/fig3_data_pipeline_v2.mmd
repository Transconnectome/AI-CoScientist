%%{init: {'theme': 'base'}}%%
flowchart LR
    subgraph DATA["데이터 수집: 70K+ MRI, 30Kh EEG"]
        UKB["UK Biobank<br/>50,000명<br/>45-82세"]
        ABCD["ABCD Study<br/>12,000명<br/>9-14세"]
        HCP["HCP 발달+노화<br/>2,500명<br/>5-100세"]
        TUEG["Temple 뇌파<br/>30,000시간<br/>전 연령"]
