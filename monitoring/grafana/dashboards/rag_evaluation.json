{
  "dashboard": {
    "title": "AI-CoScientist RAG Evaluation Metrics",
    "tags": ["rag", "evaluation", "performance", "cost"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "RAG Performance Overview",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
        "targets": [
          {
            "expr": "rate(rag_requests_total[5m])",
            "legendFormat": "Requests/sec",
            "refId": "A"
          },
          {
            "expr": "avg(rag_latency_seconds)",
            "legendFormat": "Avg Latency",
            "refId": "B"
          },
          {
            "expr": "sum(rag_cost_usd_total)",
            "legendFormat": "Total Cost",
            "refId": "C"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,
        "title": "RAGAS Evaluation Scores (Daily)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rag_evaluation_faithfulness",
            "legendFormat": "Faithfulness",
            "refId": "A"
          },
          {
            "expr": "rag_evaluation_answer_relevancy",
            "legendFormat": "Answer Relevancy",
            "refId": "B"
          },
          {
            "expr": "rag_evaluation_context_precision",
            "legendFormat": "Context Precision",
            "refId": "C"
          },
          {
            "expr": "rag_evaluation_context_recall",
            "legendFormat": "Context Recall",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 3,
        "title": "Performance Latency by Operation",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_latency_seconds_bucket[5m])) by (le, operation))",
            "legendFormat": "{{operation}} (p95)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(rag_latency_seconds_bucket[5m])) by (le, operation))",
            "legendFormat": "{{operation}} (p50)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 4,
        "title": "Cost Breakdown by Operation",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(rag_cost_usd_total) by (operation)",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "right"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 5,
        "title": "Token Usage Over Time",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(rag_tokens_total{type=\"prompt\"}[5m])",
            "legendFormat": "Prompt Tokens/sec",
            "refId": "A"
          },
          {
            "expr": "rate(rag_tokens_total{type=\"completion\"}[5m])",
            "legendFormat": "Completion Tokens/sec",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Budget Utilization",
        "type": "gauge",
        "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rag_budget_usage_ratio",
            "legendFormat": "Budget Usage",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.8, "color": "yellow"},
                {"value": 0.95, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "A/B Test Performance Comparison",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "avg(rag_ab_test_score) by (variant)",
            "legendFormat": "{{variant}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 8,
        "title": "Weekly Cost Trend",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(rag_cost_usd_total[7d]))",
            "legendFormat": "Weekly Cost",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 9,
        "title": "Request Success Rate",
        "type": "stat",
        "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(rag_requests_total{status=\"success\"}[5m])) / sum(rate(rag_requests_total[5m]))",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.95, "color": "yellow"},
                {"value": 0.99, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Active A/B Tests",
        "type": "stat",
        "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "count(rag_ab_test_status{status=\"active\"})",
            "legendFormat": "Active Tests",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        }
      },
      {
        "id": 11,
        "title": "Evaluation Dataset Size",
        "type": "stat",
        "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rag_evaluation_dataset_size",
            "legendFormat": "Dataset Items",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 12,
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"x": 18, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(rag_cache_hits_total[5m]) / (rate(rag_cache_hits_total[5m]) + rate(rag_cache_misses_total[5m]))",
            "legendFormat": "Cache Hit Rate",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.5, "color": "yellow"},
                {"value": 0.8, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}
